<?xml version="1.0" encoding="utf-8"?>
<!-- UI 美化·令牌化：夜间冷启动窗口主题，消除暗色模式下白闪
     （原仅 values/styles.xml 一套浅色窗口背景，深色用户启动瞬间白底）。
     色值与 XTunnelTheme darkColors() 的 background 令牌对齐。 -->
<resources>
    <style name="Theme.XTunnel" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">#0F172A</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">#0F172A</item>
        <item name="android:statusBarColor">#0F172A</item>
    </style>
</resources>
